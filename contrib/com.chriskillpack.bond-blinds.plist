<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The blinds daemon, kept running in the background. Replace __EXEC__,
  __PROJECT__, __CONFIG__ and __USER__ with real values before installing; see
  the Running at startup section of the README.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chriskillpack.bond-blinds</string>

    <!-- Exec the venv entry point directly rather than going through
         `uv run`. macOS grants Local Network access per binary, and the uv
         launcher is ad-hoc signed and re-resolves the interpreter on every
         start, so there is no stable identity for the grant to attach to. -->
    <key>ProgramArguments</key>
    <array>
        <string>__EXEC__</string>
        <string>--config</string>
        <string>__CONFIG__</string>
    </array>

    <!-- Runs in the system domain, not gui/: the daemon comes up at boot with
         no one logged in, and processes outside a login session are not
         subject to the Local Network privacy prompt, which a background
         process has no way to answer. -->
    <key>UserName</key>
    <string>__USER__</string>

    <!-- solar_history.jsonl and a relative logging.file are resolved against
         the working directory, so anchor it to the project. -->
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- The daemon is meant to be up whenever the machine is. -->
    <key>KeepAlive</key>
    <true/>

    <!-- A config error still exits immediately; without this KeepAlive would
         spin on it. An unreachable bridge is retried in-process instead. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Startup failures and tracebacks only. The daemon's own log is
         logging.file in config.yaml; pointing both at one file would give
         every line twice, since it logs to stdout as well. -->
    <key>StandardOutPath</key>
    <string>__PROJECT__/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/launchd.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
